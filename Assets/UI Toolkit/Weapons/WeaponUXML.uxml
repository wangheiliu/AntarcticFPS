<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/Weapons/WeaponUIStyle.uss?fileID=7433441132597879392&amp;guid=f93b8fd9b5ea4bc498e033774a648e04&amp;type=3#WeaponUIStyle"/>
    <ui:VisualElement name="container" picking-mode="Ignore" class="container" style="flex-grow: 1;">
        <ui:VisualElement name="main" style="flex-grow: 0; width: 15%; height: 15%; align-self: flex-end; align-content: auto; flex-direction: column; justify-content: flex-start; bottom: auto; align-items: flex-start; flex-shrink: 1; translate: 0 0%; flex-wrap: nowrap; background-color: rgba(48, 48, 48, 0.482); border-top-width: 10px; border-top-color: rgb(255, 255, 255); padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px;">
            <ui:Label text="Label" name="weapon-name" class="stat-title" style="width: 100%; font-size: 20px; margin-top: 2%; margin-right: 0%; margin-bottom: 2%; margin-left: 0%; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; -unity-text-generator: advanced; -unity-text-auto-size: best-fit 3px 20px;"/>
            <ui:Label text="Label" name="ammo-count" class="stat-display" style="width: 100%; margin-top: 1%; margin-right: 0%; margin-bottom: 1%; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; -unity-text-align: upper-right; font-size: 75px; -unity-text-generator: advanced; -unity-text-auto-size: best-fit 5px 75px; -unity-font-style: normal;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
