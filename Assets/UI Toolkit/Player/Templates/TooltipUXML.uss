:root {
}

.tooltip-label {
    color: rgb(255, 255, 255);
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 2%;
    padding-right: 2%;
    padding-bottom: 2%;
    padding-left: 2%;
    white-space: normal;
    text-overflow: clip;
    -unity-text-align: middle-left;
}

.inner-container {
    flex-grow: 1;
    position: relative;
    width: 100%;
    flex-shrink: 1;
    min-height: auto;
    background-color: rgb(64, 128, 224);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    align-self: center;
    height: 100%;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    justify-content: center;
}
