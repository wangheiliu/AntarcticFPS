<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/BaseUSSClasses/BasePromptStyles.uss?fileID=7433441132597879392&amp;guid=255fb3fba437bf24abdde75c53410956&amp;type=3#BasePromptStyles"/>
    <ui:VisualElement name="container" class="prompt-container" style="flex-grow: 1;">
        <ui:Label text="E" name="prompt" class="prompt-box" style="font-size: 85px; -unity-text-auto-size: best-fit 25px 100px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;">
            <ui:VisualElement name="prompt-progress" class="prompt-progress" style="flex-grow: 1; filter: none; background-color: rgba(36, 36, 36, 0.784); width: 100%; backdrop-filter: none; height: 0%;"/>
        </ui:Label>
        <ui:VisualElement name="prompt-text-container" class="prompt-text-container" style="flex-grow: 1; height: auto; flex-shrink: 1;">
            <ui:Label text="Interact" name="prompt-title" class="prompt-title" style="-unity-text-auto-size: none; margin-left: 2px; margin-top: 2px; font-size: 17px; padding-top: 2px; padding-bottom: 2px; margin-right: 2px;">
                <Bindings>
                    <ui:DataBinding property="text" data-source-type="ProximityPrompt, Assembly-CSharp" data-source-path="_Title_k__BackingField" binding-mode="ToTarget"/>
                </Bindings>
            </ui:Label>
            <ui:Label text="subtitle here" name="prompt-subtitle" class="prompt-subtitle" style="-unity-text-auto-size: none; -unity-text-generator: advanced; font-size: 7px; padding-left: 2px; padding-top: 2px; padding-bottom: 2px; margin-top: 2px;">
                <Bindings>
                    <ui:DataBinding property="text" data-source-type="ProximityPrompt, Assembly-CSharp" data-source-path="subtitle" binding-mode="ToTarget"/>
                </Bindings>
            </ui:Label>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
