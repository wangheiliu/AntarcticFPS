:root {
    --main-blue: rgb(27, 47, 76);
    --main-blue-light: rgb(49, 65, 89);
    --main-black: rgb(27, 27, 27);
    --main-light-color: rgb(191, 191, 191);
    --main-dark-color-active: #4d4d4d;
    --close-button-color: rgb(255, 0, 0);
    --close-button-hover-color: rgb(90, 0, 0);
    --close-button-active-color: rgb(219, 90, 90);
}

.unity-scroller--horizontal {
    width: 100%;
    margin-top: 10px;
}

.unity-scroller--vertical {
    margin-left: 10px;
}

.unity-scroller--horizontal #unity-tracker {
    background-color: rgba(0,0,0,0);
    border-top-width: 1.5px;
    border-bottom-width: 1.5px;
    border-color: var(--main-light-color);
    padding-top: 2px;
    padding-bottom: 2px;
}

.unity-scroller--vertical #unity-tracker {
    background-color: rgba(0,0,0,0);
    border-left-width: 1.5px;
    border-right-width: 1.5px;
    border-color: var(--main-light-color);
    padding-left: 2px;
    padding-right: 2px;
}

#unity-dragger {
    border-radius: 10px;
}

#unity-low-button {
    background-color: rgba(150, 150, 150, 0.3);
    border-width: 1.5px;
    border-color: var(--main-light-color);
    -unity-background-image-tint-color: rgb(255,255,255);
}

#unity-high-button {
    background-color: rgba(150,150,150,0.3);
    border-width: 1.5px;
    border-color: var(--main-light-color);
    -unity-background-image-tint-color: rgb(255,255,255);
}

.unity-scroller--horizontal #unity-low-button {
    border-top-left-radius: 7px;
    border-bottom-left-radius: 7px;
    border-right-width: 0px;
}

.unity-scroller--horizontal #unity-high-button {
    border-top-right-radius: 7px;
    border-bottom-right-radius: 7px;
    border-left-width: 0px;
}

.unity-scroller--vertical #unity-low-button {
    border-bottom-width: 0px;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
}

.unity-scroller--vertical #unity-high-button {
    border-top-width: 0px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
}

.base-close-button {
    background-color: var(--close-button-color);
    color: white;
    border-radius: 10px;
    border-width: 3px;
    border-color: white;
    transition-property: background-color, scale, color;
    transition-duration: 0.2s;
}

.base-close-button:hover {
    background-color: var(--close-button-hover-color);
    scale: 1.1;
    color: white;
}

.base-close-button:active {
    background-color: var(--close-button-active-color);
    scale: 1.05;
    color: white;
}

.base-style-button {
    width: 90%;
    background-color: white;
    border-radius: 10px;
    border-color: var(--main-light-color);
    border-width: 0;

    align-self: center;

    transition-property: background-color, color, border-width, scale;
    transition-duration: 0.2s;
}

.base-style-button:hover {
    background-color: var(--main-black);
    color: white;
    border-width: 2px;
    scale: 1.05;
}

.base-style-button:active {
    scale: 0.95;
    background-color: var(--main-dark-color-active);
    color: white;
    border-width: 2px;
}

LevelInfoElement {
    aspect-ratio: 1;
    padding: 15px;
    margin: 15px;
    border-width: 5px;
    border-radius: 10px;
    border-color: white;
    background-color: var(--main-black);
}

LevelInfoElement #level-info-image {
    align-self: center;
    min-height: 10px;
    width: 100%;
    flex-grow: 1;
    aspect-ratio: 1;
    margin: 15px 10px;
    border-width: 3px;
    border-color: var(--main-light-color);
    border-radius: 10px;
}

LevelInfoElement #level-info-title {
    color: white;
    font-size: 30px;
    -unity-font-style: bold;
}