:root {
    margin-top: 1%;
    margin-right: 1%;
    margin-bottom: 1%;
    margin-left: 1%;
    flex-direction: column;
}

Image {
    border-color: rgb(0, 0, 0);
    border-radius: 20px;
    align-self: center;
}

.unity-tab__header {
    border-color: rgb(255, 255, 255);
    border-width: 2px 2px 0 2px;
    color: rgb(0, 0, 0);
}

.unity-tab__header > .unity-tab__header-underline {
    background-color: rgb(255, 255, 255);
}

.unity-tab__header:hover {
    background-color: rgb(180, 180, 180);
    color: rgb(54, 54, 54);
}

.unity-tab__header:checked {
    background-color: rgb(49, 65, 89);
    color: rgb(255, 255, 255);
    border-color: rgb(255, 255, 255);
    border-radius: 5px 5px 0 0;
}

.unity-slider {
    width: 100%;
    margin: 0;
    min-width: 0;
    justify-content: center;
}

.unity-scroller .unity-base-slider__dragger {
    border-radius: 6px;
    min-height: 10px;
    height: 10px;
    width: 65%;
    margin: 0 auto;
    align-self: center;
}

.unity-base-slider--horizontal {
    min-height: 5px;
    height: auto;
}

#unity-drag-container {
    align-content: center;
}

#unity-tracker {
    background-color: rgba(200, 200, 200, 0);
}

.unity-scroller > .unity-slider__input {
    padding: 2%;
}

.unity-scroller--vertical > .unity-scroller__low-button,
.unity-scroller--vertical > .unity-scroller__high-button,
.unity-scroller--horizontal > .unity-scroller__low-button,
.unity-scroller--horizontal > .unity-scroller__high-button {
    display: none;
}

.unity-scroller {
    padding: 0.75%;
}

#unity-checkmark {
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.unity-foldout__toggle:focus * {
    color: white;
}

#title-container,
#tab-container {
    transition-property: translate;
    transition-timing-function: ease-in-out;
    transition-duration: 400ms;
}

.title {
}

.description {
}

.info-container {
}

#purchase-button {
    border-top-color: rgb(49, 65, 89);
    border-right-color: rgb(49, 65, 89);
    border-bottom-color: rgb(49, 65, 89);
    border-left-color: rgb(49, 65, 89);
    color: rgb(27, 47, 76);
    background-color: rgb(255, 255, 255);
}

Button.close-button {
    align-self: center;
    align-content: center;
    justify-content: center;
    width: 7%;
    aspect-ratio: 1;
    align-items: center;
    padding-top: 1%;
    padding-right: 1%;
    padding-bottom: 1%;
    padding-left: 1%;
    -unity-text-generator: advanced;
    -unity-text-auto-size: best-fit 10px 1000px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    height: 79%;
    background-size: 100% 100%;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    background-color: rgb(255, 0, 0);
    -unity-text-outline-color: rgb(0, 0, 0);
    color: rgb(255, 255, 255);
    min-width: 0;
    flex-shrink: 1;
    flex-grow: 0;
    transition-property: background-color, scale;
    transition-duration: 0.4s, 0.4s;
    transition-timing-function: ease-in-out, ease-in-out;
}

Button.close-button:enabled:hover {
    background-color: rgb(90, 0, 0);
    scale: 1.1;
}

#info-container {
    -unity-picking-mode: Ignore;
}

#info-container > #main-container {
    -unity-picking-mode: Ignore;
}

#purchase-button {
    background-color: white;
    color: rgb(27, 47, 76);
    border-color: rgb(49, 65, 89);
}

#purchase-button:hover {
    scale: 1.05;
    border-width: 10px;
    background-color: rgb(49, 65, 89);
    color: rgb(255, 255, 255);
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
}

.information {
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 1.5%;
    padding-left: 0;
    margin-top: 10px;
    margin-right: 0;
    margin-bottom: 10px;
    margin-left: 0;
    color: rgb(255, 255, 255);
    -unity-text-generator: standard;
    -unity-text-auto-size: none;
    text-overflow: clip;
    font-size: 20px;
    width: 100%;
    flex-wrap: wrap;
    white-space: normal;
    flex-shrink: 1;
}
