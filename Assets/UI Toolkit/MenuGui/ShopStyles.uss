:root {
    margin-top: 1%;
    margin-right: 1%;
    margin-bottom: 1%;
    margin-left: 1%;
}

Image {
    border-color: rgb(0, 0, 0);
    border-radius: 20px;
    align-self: center;
}

#title-container {
    picking-mode: Ignore;
}

.unity-tab__header {
    border-color: rgb(255, 255, 255);
    border-width: 2px 2px 0 2px;
    color: rgb(0, 0, 0);
}

.unity-tab__header > .unity-tab__header-underline {
    background-color: rgb(255, 255, 255);
}

.unity-tab__header:hover {
    background-color: rgb(180, 180, 180);
    color: rgb(54, 54, 54);
}

.unity-tab__header:checked {
    background-color: rgb(49, 65, 89);
    color: rgb(255, 255, 255);
    border-color: rgb(255,255,255);
    border-radius: 5px 5px 0 0;
}

.unity-slider {
    width: 100%;
    margin: 0;
    min-width: 0;
    justify-content: center;
    
}

.unity-scroller .unity-base-slider__dragger {
    border-radius: 6px;
    min-height: 10px;
    height: 10px;
    width: 65%;
    margin: 0 auto;
    align-self: center;
}

#unity-drag-container {
    align-content: center;
}

#unity-tracker {
    background-color: rgba(200, 200, 200, 0);
}

.unity-scroller > .unity-slider__input {
    padding: 2%;
}

.unity-scroller--vertical > .unity-scroller__low-button,
.unity-scroller--vertical > .unity-scroller__high-button {
    display: none;
}

.unity-scroller {
    padding: 0.75%;
}

#title-container, #tab-container {
    transition-property: translate;
    transition-timing-function: ease-in-out;
    transition-duration: 400ms;
}

.title {
}

.description {
}
