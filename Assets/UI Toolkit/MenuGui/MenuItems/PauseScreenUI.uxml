<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/MenuGui/MenuItems/PauseStyleSheet.uss?fileID=7433441132597879392&amp;guid=b4e177e455785fe46b231f0ce89ea866&amp;type=3#PauseStyleSheet"/>
    <Style src="project://database/Assets/UI%20Toolkit/BaseUSSClasses/BaseStylesSheet.uss?fileID=7433441132597879392&amp;guid=7f75f34ea05197248973cb4a54cdaa80&amp;type=3#BaseStylesSheet"/>
    <ui:VisualElement name="container" class="container pause-enabled" style="flex-grow: 1; width: 100%; height: 100%; justify-content: center; align-items: center;">
        <ui:VisualElement name="main" style="flex-grow: 0; width: 90%; height: 80%; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px;">
            <ui:Label text="Paused" name="paused-text" class="title" style="font-size: 100px; flex-shrink: 1; width: 100%; -unity-text-align: upper-center; white-space: pre;"/>
            <ui:VisualElement name="btn-container" style="flex-grow: 1; justify-content: flex-end;">
                <ui:VisualElement name="btn-group" style="flex-grow: 0; flex-direction: column; align-self: center; align-items: center; flex-shrink: 1; flex-basis: auto; justify-content: flex-start; width: 70%;">
                    <ui:Button text="Continue" name="continue-btn" class="button-selection" style="flex-grow: 1; flex-basis: auto; width: 100%;"/>
                    <ui:Button text="Settings" name="settings-btn" class="button-selection" style="flex-grow: 1; flex-basis: auto; width: 100%;"/>
                    <ui:Button text="Exit to Main Menu" name="exit-btn" class="button-selection" style="flex-grow: 1; flex-basis: auto; align-items: stretch; width: 100%;"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
