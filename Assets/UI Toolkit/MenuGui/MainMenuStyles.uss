:root {
    margin-top: 1%;
    margin-right: 3%;
    margin-bottom: 1%;
    margin-left: 3%;
}

.title {
    font-size: 100px;
    -unity-font-style: bold;
}

.button {
    font-size: 45px;
    width: 25%;
    height: 7%;
    margin-top: 10px;
    margin-right: 0;
    margin-bottom: 10px;
    margin-left: 0;
    min-width: 0;
    
    transition-property: background-color;
    transition-duration: 0.2s;
}

.title,
.container {
    transition-property: translate;
    transition-timing-function: ease-in-out;
    transition-duration: 400ms;
}

.container {
    left: auto;
}
